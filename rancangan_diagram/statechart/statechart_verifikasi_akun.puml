@startuml
!theme plain
skinparam shadowing false
skinparam dpi 130
skinparam defaultFontSize 11

title Verifikasi Akun Penyelenggara (Class: Users)

state "Terdaftar\n(disetujui: false)" as registered
state "Ditolak\n(disetujui: false)" as rejected
state "Disetujui\n(disetujui: true)" as approved

[*] --> registered : Penyelenggara melakukan registrasi

registered --> approved : Admin menyetujui
registered --> rejected : Admin menolak

rejected --> registered : Penyelenggara mendaftar ulang

approved --> [*]

note right of registered
  Akun organizer belum
  bisa membuat event
end note

note right of approved
  Akun organizer bisa
  membuat event
end note

note right of rejected
  Ada alasan penolakan
  dari admin
end note

@enduml
