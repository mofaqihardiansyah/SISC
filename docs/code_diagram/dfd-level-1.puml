@startuml
!theme plain
skinparam rectangle {
  BorderColor #333333
  BackgroundColor #E8F4FD
}
skinparam circle {
  BorderColor #0066cc
  BackgroundColor #D6EAF8
}
skinparam database {
  BorderColor #666666
  BackgroundColor #FEF9E7
}

title DFD Level 1 — SISC

' ── EXTERNAL ENTITIES ───
rectangle "VISITOR" as visitor
rectangle "ORGANIZER" as organizer
rectangle "ADMIN" as admin

' ── PROCESSES ───
circle "P1\nKelola\nAkun" as p1
circle "P2\nKelola\nEvent" as p2
circle "P3\nPendaftaran\n& Bayar" as p3
circle "P4\nPaper" as p4
circle "P5\nFavorit" as p5
circle "P6\nAdmin &\nVerifikasi" as p6

' ── DATA STORES ───
database "D1\nUsers/OTP" as d1
database "D2\nProfil Org" as d2
database "D3\nWilayah" as d3
database "D4\nKat & Tag" as d4
database "D5\nEvent" as d5
database "D6\nInfo Bayar" as d6
database "D7\nPembicara" as d7
database "D8\nLamp & Jadwal" as d8
database "D9\nPendaftaran" as d9
database "D10\nPeserta" as d10
database "D11\nPaper" as d11
database "D12\nFavorit" as d12
database "D13\nLog Admin" as d13

' ── FLOWS: EXTERNAL → PROCESS ──
visitor --> p1 : data registrasi, login, OTP
visitor --> p3 : daftar event, upload bukti, data peserta
visitor --> p4 : submit paper
visitor --> p5 : tambah/hapus favorit

organizer --> p2 : data event, pembicara, jadwal, lampiran

admin --> p6 : keputusan verif, manajemen user, kelola info bayar

' ── FLOWS: PROCESS → EXTERNAL ──
p1 --> visitor : profil, status login
p3 --> visitor : kode pendaftaran, kode peserta
p4 --> visitor : status paper
p5 --> visitor : daftar favorit

p2 --> organizer : status verifikasi
p6 --> organizer : status event

p6 --> admin : log aktivitas, dashboard

' ── FLOWS: PROCESS → STORE ──
p1 --> d1
p1 --> d2

p2 --> d3
p2 --> d4
p2 --> d5
p2 --> d7
p2 --> d8

p3 --> d5
p3 --> d6
p3 --> d9
p3 --> d10

p4 --> d5
p4 --> d11

p5 --> d12

p6 --> d1
p6 --> d3
p6 --> d4
p6 --> d5
p6 --> d6
p6 --> d9
p6 --> d13

' ── FLOWS: STORE → PROCESS ──
d1 --> p1
d1 --> p3
d1 --> p4
d2 --> p1

d3 --> p2
d3 --> p6
d4 --> p2
d4 --> p6
d5 --> p2
d5 --> p3
d5 --> p4
d5 --> p6
d6 --> p3

d8 --> p2
d9 --> p3
d9 --> p6
d10 --> p3
d10 --> p6
d11 --> p4
d11 --> p6
d12 --> p5
d13 --> p6

@enduml
