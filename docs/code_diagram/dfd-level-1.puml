@startuml
!theme plain
skinparam roundcorner 10
skinparam usecase {
  BackgroundColor lightblue
  BorderColor black
}
skinparam database {
  BackgroundColor lightyellow
  BorderColor black
}

actor "Visitor" as Visitor
actor "Organizer" as Organizer
actor "Admin" as Admin

database "D1\nUsers & Profil" as D1
database "D2\nEvents & Master Data" as D2
database "D3\nPendaftaran & Peserta" as D3
database "D4\nPaper Submissions" as D4

usecase "1.0\nManajemen\nAkun & Autentikasi" as P1
usecase "2.0\nManajemen\nEvent" as P2
usecase "3.0\nPendaftaran\n& Pembayaran" as P3
usecase "4.0\nManajemen\nPaper" as P4
usecase "5.0\nManajemen\nFavorit" as P5
usecase "6.0\nVerifikasi\n& Administrasi" as P6

Visitor --> P1 : "Registrasi"
Organizer --> P1 : "Registrasi & Profil"
P1 --> D1 : "Simpan Data User"
P1 --> Visitor : "Kode OTP"

Organizer --> P2 : "Data Event, Pembicara,\nLampiran, Jadwal"
P2 --> D2 : "Simpan Data Event"
D2 -.-> Visitor : "Katalog Event"

Visitor --> P3 : "Data Peserta &\nBukti Pembayaran"
D2 -.-> P3 : "Info Harga & Kuota"
P3 --> D3 : "Simpan Pendaftaran"
P3 --> Visitor : "Tiket/Status"

Visitor --> P4 : "File & Data Paper"
P4 --> D4 : "Simpan Paper"
D4 -.-> Organizer : "Daftar Paper"
Organizer --> P4 : "Hasil Review"
P4 --> Visitor : "Status Paper"

Visitor --> P5 : "Aksi Favorit"
P5 --> D2 : "Simpan Relasi Favorit"

Admin --> P6 : "Aksi Verifikasi,\nManajemen Master Data"
D2 -.-> P6 : "Daftar Event Pending"
P6 --> D2 : "Update Status Event"
P6 --> D1 : "Simpan Log Aktivitas"
@enduml